# Environment for the mage-mediagc systemd units.
#
# Installed as /etc/mage-mediagc/mage-mediagc.env and read by both timers.
# systemd's EnvironmentFile format is plain KEY=value: no `export`, and quotes
# are taken literally, so do not wrap values in them.

# ---------------------------------------------------------------------------
# Required: which shop to operate on
# ---------------------------------------------------------------------------

# The Magento installation root, i.e. the directory containing app/etc/env.php.
# Database credentials, the media path and the table prefix are all derived
# from this file, so in most installations nothing else is needed here.
MAGEGC_MAGENTO_ROOT=/var/www/magento

# ---------------------------------------------------------------------------
# Optional: overrides
# ---------------------------------------------------------------------------

# Use the stock pub/media/catalog/product below the root unless set.
# MAGEGC_MEDIA_PATH=/var/www/magento/pub/media/catalog/product

# Point at a replica or a different server than env.php does. Setting any of
# these overrides the corresponding value from env.php.
# MAGEGC_DB_HOST=127.0.0.1
# MAGEGC_DB_PORT=3306
# MAGEGC_DB_NAME=magento
# MAGEGC_DB_USER=magegc_ro
# MAGEGC_DB_PASSWORD=
# MAGEGC_DB_SOCKET=/var/run/mysqld/mysqld.sock

# Parallel walkers. Leave unset to use one per CPU, capped at 16.
# MAGEGC_WORKERS=8

# Holding directory for quarantined files. Must be on the same filesystem as
# the media tree.
# MAGEGC_QUARANTINE_DIR=/data/mage-mediagc-quarantine

# Default report format for the weekly scan: table | json | markdown
MAGEGC_FORMAT=markdown
