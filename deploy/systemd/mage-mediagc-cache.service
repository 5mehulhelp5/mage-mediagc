[Unit]
Description=mage-mediagc thumbnail cache cleanup
Documentation=https://github.com/shuaiZend/mage-mediagc/blob/main/docs/operations.md
After=network-online.target

[Service]
Type=oneshot
EnvironmentFile=-/etc/mage-mediagc/mage-mediagc.env

# The one destructive operation that needs no confirmation: the thumbnail
# cache is pure derived data and Magento regenerates each variant on first
# request. Nothing references these files by name.
ExecStart=/usr/local/bin/mage-mediagc cache clean \
    --config /etc/mage-mediagc/mage-mediagc.yaml \
    --apply

# This job writes to the media tree, so it must run as a user that can
# recreate pub/media/catalog/product/cache. Default to the web server user.
# User=www-data
# Group=www-data

Nice=15
IOSchedulingClass=idle
TimeoutStartSec=3600

ProtectSystem=full
PrivateTmp=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native

StandardOutput=journal
StandardError=journal
SyslogIdentifier=mage-mediagc-cache

[Install]
WantedBy=multi-user.target
